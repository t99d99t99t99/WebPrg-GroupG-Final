{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!**/*.md", "!package-lock.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120
    },
    "overrides": [
        {
            "includes": ["package.json", "**/*.yml"],
            "formatter": {
                "indentWidth": 2
            }
        }
    ]
}
